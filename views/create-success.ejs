<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Account Created</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="min-h-screen bg-gradient-to-r from-green-400 via-blue-500 to-purple-500 flex items-center justify-center">

  <div class="bg-white rounded-2xl shadow-2xl p-10 max-w-md text-center space-y-6">
    <h1 class="text-3xl font-bold text-gray-800">🎉 Account Created Successfully!</h1>
    <p class="text-gray-600">Your account has been created. You can now log in and start using the app.</p>
    
    <!-- Login Button -->
    <a href="/login" 
       class="block w-full bg-indigo-500 text-white py-3 rounded-lg font-medium hover:bg-indigo-600 transition duration-200">
       🔑 Login Now
    </a>

    <!-- Optional: Go to Home -->
    <a href="/" 
       class="block w-full bg-gray-200 text-gray-800 py-2 rounded-lg font-medium hover:bg-gray-300 transition duration-200">
       🏠 Back to Home
    </a>
  </div>

</body>
</html>
